# All optional. With none set, production returns 503 and the page falls back to WhatsApp.
# Google Sheet: Apps Script web-app URL (see README > Lead capture)
LEAD_SHEET_WEBHOOK=
# Resend: team email for every enquiry
RESEND_API_KEY=
LEAD_NOTIFY_TO=info@zmediage.com
# Verified Resend sender, e.g. "Zmediage <hello@zmediage.com>". Turns on a short thank-you reply when they leave an email.
LEAD_FROM=
